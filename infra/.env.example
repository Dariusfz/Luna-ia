# Credenciales de los servicios de infraestructura (desarrollo).
# Copiar a infra/.env y reemplazar TODOS los valores. infra/.env NO se versiona.
#
# Generar secretos:
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | ForEach-Object {[char]$_})
#   Linux/macOS: openssl rand -base64 32
#
# IMPORTANTE: la contraseña de PostgreSQL debe coincidir con el usuario y la
# contraseña de DATABASE_URL en backend/.env (si contiene caracteres especiales,
# codificarlos para URL: @ -> %40, : -> %3A, / -> %2F, # -> %23).

POSTGRES_DB=luna_ia
POSTGRES_USER=luna
POSTGRES_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Evolution API (WhatsApp). Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# EVOLUTION_API_KEY debe ser igual a EVOLUTION_API_KEY de backend/.env.
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_DB_PASSWORD=

# Token del túnel de Cloudflare (Zero Trust) para producción.
# Solo lo usa el servicio `cloudflared` con el perfil `tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=
