# Copiar a backend/.env y ajustar. backend/.env NO se sube al repositorio.
#
# Generar DJANGO_SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Generar TOTP_ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Debe coincidir con POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB de infra/.env.
# Si la contraseña tiene caracteres especiales, codificarlos para URL (@ -> %40, : -> %3A, / -> %2F, # -> %23).
DATABASE_URL=postgres://luna:CAMBIAR_PASSWORD@127.0.0.1:5432/luna_ia
REDIS_URL=redis://127.0.0.1:6379/0

# URL del frontend para los enlaces de invitación y recuperación de contraseña.
FRONTEND_URL=http://localhost:5173

# Correo saliente. Por defecto Mailpit (solo captura, no entrega).
# Para enviar correos reales, configurar los datos del proveedor SMTP.
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="LUNA-IA <no-reply@luna-ia.local>"

# Clave Fernet para cifrar los secretos TOTP en la base de datos.
# Obligatoria en producción. Si se omite en desarrollo se deriva de DJANGO_SECRET_KEY.
TOTP_ENCRYPTION_KEY=

# LLM agnóstico (compatible-OpenAI). Dev: Ollama en el host.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b
# Reintentos si el proveedor responde 429 (límite de peticiones). Espera Retry-After.
LLM_REINTENTOS_429=2
# Identificación ante gateways (OpenCode Go exige un User-Agent propio).
LLM_USER_AGENT=LUNA-IA/1.0
# OpenCode Go (compatible-OpenAI): descomentar y poner la API key.
# LLM_PROVIDER=opencode-go
# LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
# LLM_MODEL=deepseek-v4.1-flash

# Clave Fernet para cifrar el contenido de los mensajes de WhatsApp (api_agente).
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MENSAJES_ENCRYPTION_KEY=

# Evolution API (WhatsApp). Dev: contenedor en infra/docker-compose.dev.yml.
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=luna-ia
# Secreto en la ruta del webhook; debe coincidir con EVOLUTION_WEBHOOK_SECRET de infra/.env.
EVOLUTION_WEBHOOK_SECRET=

# Número(s) de WhatsApp del administrador para avisos del agente
# (cita creada, tratamiento no disponible). Separar varios con coma.
# Usar un número distinto al de la clínica. Ejemplo:
# ADMIN_WHATSAPP=+50499999999,+50488888888
ADMIN_WHATSAPP=
# Interruptor general de los avisos al administrador. Déjalo en True en producción.
# En tests se apaga automáticamente para no enviar mensajes reales.
NOTIFICACIONES_WHATSAPP=True

# Evolution (Docker) llama a Django en el host: añadir host.docker.internal a DJANGO_ALLOWED_HOSTS.

# Transcripción de notas de voz (faster-whisper). El modelo se descarga la primera vez
# que se transcribe un audio y queda en la caché de Hugging Face.
# Modelos: tiny, base, small, medium, large-v3. `small` es el equilibrio en CPU/GPU modesta.
WHISPER_MODEL=small
# auto = usa la GPU si está disponible; cpu fuerza CPU.
WHISPER_DEVICE=auto
# int8 funciona en CPU y GPU; en GPU con más memoria se puede usar float16.
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es
WHISPER_BEAM_SIZE=5
